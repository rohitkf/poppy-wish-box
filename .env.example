# Postgres — added automatically when you connect Neon in Vercel → Storage.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Direct (non-pooled) connection, used for LISTEN/NOTIFY live sync.
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Vercel Blob (private store) — added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# The numeric code that unlocks the app (4–12 digits). Changing it signs every device out.
APP_PIN=
